{"heartily":{"pos":"副詞","meaning":"【副】心から、元気よく、勢いよく。","tags":["stage-direction","delivery-cue"]},"hum":{"pos":"動詞・名詞","meaning":"【動】鼻歌を歌う。\n【名】鼻歌、低いうなり音。","tags":["stage-direction","sound"]},"in charge":{"pos":"定型表現","meaning":"責任者として、取り仕切って。","tags":["stage","scene-setting"]},"judicial manner":{"pos":"名詞句","meaning":"【名】裁判官のような、厳粛で権威を感じさせる態度・物腰。","tags":["stage-direction","acting"]},"jump":{"pos":"動詞","meaning":"【動】①跳ぶ\n②驚いてびくっとする。","tags":["stage-direction","movement"]},"laugh":{"pos":"動詞・名詞","meaning":"【動】笑う。\n【名】笑い。","tags":["stage-direction","acting"]},"lean":{"pos":"動詞","meaning":"【動】寄りかかる、身をもたせる。","tags":["stage-direction","movement"]},"leer":{"pos":"動詞・名詞","meaning":"【動】いやらしい・不気味な目つきで見る。\n【名】そのような目つき。","tags":["stage-direction","gesture"]},"light":{"pos":"動詞・名詞","meaning":"【動】①火をつける\n②照らす。\n【名】光、照明。","tags":["stage-direction","lighting"]},"light switch":{"pos":"名詞","meaning":"【名】照明のスイッチ。","tags":["stage-direction","lighting"]},"look":{"pos":"動詞","meaning":"【動】見る、目を向ける。","tags":["stage-direction","gesture"]},"meaningly":{"pos":"副詞","meaning":"【副】意味ありげに、含みを持たせて。","tags":["stage-direction","delivery-cue"]},"move":{"pos":"動詞","meaning":"【動】①動く、移動する\n②【舞台】指定された舞台位置へ移る。","tags":["theatre","movement"]},"no answer":{"pos":"舞台用語","meaning":"【舞台】問いかけに誰も返答せず、沈黙が続くことを示す指示。","tags":["theatre","pause"]},"open":{"pos":"動詞","meaning":"【動】開ける、開く。","tags":["stage-direction","movement"]},"out of sight":{"pos":"定型表現","meaning":"見えない所に、視界の外に。","tags":["stage-direction","stage-position"]},"pane":{"pos":"名詞","meaning":"【名】窓などにはめ込まれた一枚のガラス板。","tags":["stage","set"]},"paralysed":{"pos":"形容詞","meaning":"【形】①麻痺した\n②恐怖・驚きなどで動けない。","tags":["stage-direction","acting"]},"pause":{"pos":"動詞・名詞","meaning":"【動】一時止まる。\n【名】間、休止。","tags":["theatre","delivery-cue"]},"peer":{"pos":"動詞","meaning":"【動】目を凝らして見る、のぞき込む。","tags":["stage-direction","gesture"]},"perplexed":{"pos":"形容詞","meaning":"【形】当惑した、困惑した。","tags":["stage-direction","acting"]},"pick out with one finger":{"pos":"動詞句","meaning":"【動】（旋律を）一本の指で一音ずつ拾うように弾く。","tags":["stage-direction","music"]},"pick up":{"pos":"句動詞","meaning":"【句動】拾い上げる、手に取る。","tags":["stage-direction","movement"]},"point":{"pos":"動詞","meaning":"【動】指さす、方向を示す。","tags":["stage-direction","gesture"]},"practically dark":{"pos":"形容表現","meaning":"ほとんど真っ暗で。","tags":["stage-direction","lighting"]},"presently":{"pos":"副詞","meaning":"【副】まもなく、やがて。","tags":["British English","dated","stage-direction"]},"pull back the curtain":{"pos":"動詞句","meaning":"【動】カーテンを引いて開ける。","tags":["stage-direction","movement"]},"reappear":{"pos":"動詞","meaning":"【動】再び姿を現す、再登場する。","tags":["stage-direction","entrance"]},"rearrange":{"pos":"動詞","meaning":"【動】並べ替える、配置し直す。","tags":["stage-direction","movement"]},"refectory table":{"pos":"名詞","meaning":"【名】食堂用の長い大型テーブル。","tags":["stage","set"]},"register disapproval":{"pos":"動詞句","meaning":"【動】不賛成・不快感を表情や態度にはっきり表す。","tags":["stage-direction","acting"]},"return":{"pos":"動詞","meaning":"【動】戻る、帰る。","tags":["stage-direction","movement"]},"rise":{"pos":"動詞","meaning":"【動】①立ち上がる\n②上がる。","tags":["stage-direction","movement"]},"scene heading":{"pos":"舞台用語","meaning":"【舞台】幕・場の冒頭で場面を示す見出し。","tags":["theatre","scene-setting"]},"scene setting":{"pos":"舞台用語","meaning":"【舞台】場所・時刻・状況など、場面開始時の設定説明。","tags":["theatre","scene-setting"]}}