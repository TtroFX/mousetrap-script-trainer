{"scream":{"pos":"動詞・名詞","meaning":"【動】叫び声を上げる。\n【名】鋭い叫び声。","tags":["stage-direction","sound"]},"scuffle":{"pos":"名詞・動詞","meaning":"【名】もみ合い・小競り合い、またその物音。\n【動】もみ合う。","tags":["stage-direction","sound"]},"shake one’s head":{"pos":"動詞句","meaning":"【動】首を横に振る。通常、否定・不同意などを示す。","tags":["stage-direction","gesture"]},"sharply":{"pos":"副詞","meaning":"【副】鋭く、急に、きつい調子で。","tags":["stage-direction","delivery-cue"]},"shiver":{"pos":"動詞・名詞","meaning":"【動】寒さ・恐怖などで震える。\n【名】震え。","tags":["stage-direction","acting"]},"sigh":{"pos":"動詞・名詞","meaning":"【動】ため息をつく。\n【名】ため息。","tags":["stage-direction","acting"]},"silence":{"pos":"名詞","meaning":"【名】沈黙、静寂。","tags":["stage-direction","pause"]},"sing":{"pos":"動詞","meaning":"【動】歌う。","tags":["stage-direction","sound"]},"sit":{"pos":"動詞","meaning":"【動】座る、腰掛ける。","tags":["stage-direction","movement"]},"slowly":{"pos":"副詞","meaning":"【副】ゆっくりと。","tags":["stage-direction","delivery-cue"]},"smooth":{"pos":"動詞","meaning":"【動】平らにする、しわを伸ばす、なでつける。","tags":["stage-direction","gesture"]},"softly":{"pos":"副詞","meaning":"【副】静かに、そっと、柔らかな調子で。","tags":["stage-direction","delivery-cue"]},"stand":{"pos":"動詞","meaning":"【動】立つ、立っている。","tags":["stage-direction","movement"]},"take":{"pos":"動詞","meaning":"【動】取る、手に取る。","tags":["stage-direction","movement"]},"tap":{"pos":"名詞・動詞","meaning":"【名】軽くたたく音・動作。\n【動】軽くたたく。","tags":["stage-direction","sound"]},"telephone receiver":{"pos":"名詞","meaning":"【名】電話の受話器。","tags":["dated-technology","stage-direction"]},"tidy up":{"pos":"句動詞","meaning":"【句動】片づける、整える。","tags":["stage-direction","movement"]},"torch":{"pos":"名詞","meaning":"【名】①【英】懐中電灯\n②たいまつ。","tags":["British English","stage-prop"]},"trace":{"pos":"動詞","meaning":"【動】たどる、追跡して経路を確かめる。","tags":["stage-direction","movement"]},"tune in":{"pos":"句動詞","meaning":"【句動】①ラジオ・テレビを選局する\n②周波数を合わせる。","tags":["dated-technology","stage-direction"]},"turn":{"pos":"動詞","meaning":"【動】向きを変える、振り向く、回す。","tags":["stage-direction","movement"]},"upstage":{"pos":"舞台用語","meaning":"【舞台】舞台の客席から遠い奥側。","tags":["theatre","stage-position"]},"upstage centre":{"pos":"舞台用語","meaning":"【舞台】舞台中央の奥側。","tags":["theatre","stage-position"]},"upstage left":{"pos":"舞台用語","meaning":"【舞台】俳優が客席を向いたときの左側で、舞台奥の区域。","tags":["theatre","stage-position"]},"upstage right":{"pos":"舞台用語","meaning":"【舞台】俳優が客席を向いたときの右側で、舞台奥の区域。","tags":["theatre","stage-position"]},"wall bracket":{"pos":"名詞","meaning":"【名】壁に取り付ける照明器具・壁付け灯。","tags":["stage","set","lighting"]},"watch":{"pos":"動詞","meaning":"【動】注意して見る、見守る。","tags":["stage-direction","gesture"]},"whistle":{"pos":"動詞・名詞","meaning":"【動】口笛を吹く。\n【名】口笛、笛の音。","tags":["stage-direction","sound"]},"with a start":{"pos":"副詞句","meaning":"びくっとして、はっと驚いて。","tags":["stage-direction","acting"]},"assemble":{"pos":"動詞","meaning":"【動】集まる、集合する；集める。","tags":["scene-setting"]},"at breaking point":{"pos":"定型表現","meaning":"精神的・肉体的に耐えられる限界で、ぎりぎりの状態で。","tags":["stage-direction","delivery-cue"]},"Sir Christopher Wren":{"pos":"固有名詞","meaning":"【固有名詞】17世紀イングランドの建築家クリストファー・レン（1632–1723）。","tags":["proper-noun","culture","architecture"]},"St Paul’s Cathedral":{"pos":"固有名詞","meaning":"【固有名詞】ロンドンにあるセント・ポール大聖堂。","tags":["proper-noun","place","culture"]},"Christopher Wren":{"pos":"固有名詞","meaning":"【固有名詞】Christopher Wren という人名。","tags":["proper-noun","person"]},"humph":{"pos":"間投詞","meaning":"【間】ふん、やれやれ。疑い・不満・軽蔑などを示す。","tags":["interjection"]}}